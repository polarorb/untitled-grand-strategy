// Scripted historical events. Body text is the teletype voice: terse,
// clipped, wire-service. The first option is the historical/default
// choice, auto-applied when the deciding country's deadline passes.
[
    EventDef(
        id: "hbomb-decision",
        trigger: Date((1950, 1, 31, 12)),
        title: "THE SUPER: THE PRESIDENT MUST DECIDE",
        body: "WASHINGTON -- SPECIAL COMMITTEE OF THE NATIONAL SECURITY COUNCIL RECOMMENDS PROCEEDING WITH DEVELOPMENT OF THE HYDROGEN BOMB. GENERAL ADVISORY COMMITTEE MAJORITY REPORT OPPOSES -- OPPENHEIMER AND CONANT CALL THE SUPER A WEAPON OF GENOCIDE. SOVIET ATOMIC TEST HAS CHANGED EVERY CALCULATION. AEC AWAITS DECISION.",
        country: Some(("USA")),
        deadline_days: 7,
        options: [
            EventOption(
                label: "PROCEED WITH THE SUPER",
                effects: [
                    AuthorizeThermonuclear(country: ("USA")),
                    AdjustTension(30),
                ],
            ),
            EventOption(
                label: "DECLINE -- FISSION IS ENOUGH",
                effects: [
                    AdjustTension(-10),
                ],
            ),
        ],
    ),
    EventDef(
        id: "fuchs-arrest",
        trigger: Date((1950, 2, 2, 12)),
        title: "ATOMIC SCIENTIST ARRESTED AS SOVIET SPY",
        body: "LONDON -- DR KLAUS FUCHS, HEAD OF THEORETICAL PHYSICS AT HARWELL AND VETERAN OF LOS ALAMOS, ARRESTED UNDER THE OFFICIAL SECRETS ACT. CONFESSION INDICATES WEAPON DESIGN DATA PASSED TO SOVIET INTELLIGENCE SINCE 1944. THE SOVIET BOMB DID NOT COME FROM NOWHERE. DAMAGE ASSESSMENT UNDERWAY.",
        effects: [
            AdjustTension(20),
        ],
    ),
    EventDef(
        id: "burgess-maclean",
        trigger: Date((1951, 5, 25, 6)),
        title: "TWO BRITISH DIPLOMATS VANISH",
        body: "LONDON -- FOREIGN OFFICE OFFICIALS GUY BURGESS AND DONALD MACLEAN HAVE DISAPPEARED, LAST SEEN BOARDING A CROSS-CHANNEL STEAMER. MACLEAN WAS DAYS FROM INTERROGATION OVER ATOMIC LEAKS. SPECULATION MOUNTS THAT THEY WERE TIPPED BY A THIRD MAN STILL INSIDE. THE SPECIAL RELATIONSHIP IS STRAINED.",
        effects: [
            AdjustTension(25),
        ],
    ),
    EventDef(
        id: "rosenberg-execution",
        trigger: Date((1953, 6, 19, 20)),
        title: "ROSENBERGS EXECUTED AT SING SING",
        body: "NEW YORK -- JULIUS AND ETHEL ROSENBERG WENT TO THE ELECTRIC CHAIR TONIGHT FOR CONSPIRACY TO COMMIT ATOMIC ESPIONAGE, THE FIRST US CIVILIANS EXECUTED FOR SUCH A CRIME. PROTESTS IN EUROPEAN CAPITALS. THE SENTENCE DIVIDES ALLIES AS MUCH AS ENEMIES. THE SECRET, WHATEVER IT WAS, IS SPENT.",
        effects: [
            AdjustTension(20),
        ],
    ),
    EventDef(
        id: "petrov-defection",
        trigger: Date((1954, 4, 3, 10)),
        title: "SOVIET SPY CHIEF DEFECTS IN CANBERRA",
        body: "CANBERRA -- VLADIMIR PETROV, THIRD SECRETARY AND MVD RESIDENT, HAS SOUGHT ASYLUM, BRINGING DOCUMENTS ON SOVIET NETWORKS ACROSS THE WEST. HIS WIFE WAS NEARLY DRAGGED ABOARD A MOSCOW-BOUND AIRCRAFT BEFORE POLICE INTERVENED AT DARWIN. A ROYAL COMMISSION IS CONVENED. MOSCOW SEVERS RELATIONS.",
        effects: [
            AdjustTension(20),
        ],
    ),
    EventDef(
        id: "sino-soviet-treaty",
        trigger: Date((1950, 2, 14, 12)),
        title: "SINO-SOVIET TREATY SIGNED",
        body: "MOSCOW -- FLASH -- USSR AND PEOPLES REPUBLIC OF CHINA SIGN TREATY OF FRIENDSHIP ALLIANCE AND MUTUAL ASSISTANCE. STALIN AND MAO COMMIT TO MUTUAL DEFENSE FOR THIRTY YEARS. SOVIET CREDITS AND TECHNICAL AID TO FOLLOW. THE SOCIALIST CAMP NOW SPANS FROM THE ELBE TO THE SOUTH CHINA SEA.",
        effects: [
            AdjustTension(30),
        ],
    ),
    EventDef(
        id: "korea-invasion",
        trigger: Date((1950, 6, 25, 4)),
        title: "NORTH KOREA INVADES SOUTH KOREA",
        body: "SEOUL -- FLASH FLASH FLASH -- KOREAN PEOPLES ARMY CROSSES 38TH PARALLEL IN FORCE AT 0400 LOCAL. ARTILLERY PREPARATION FOLLOWED BY ARMORED COLUMNS ON KAESONG-SEOUL AXIS. ROK POSITIONS OVERRUN AT MULTIPLE POINTS. ATTACK APPEARS GENERAL ALONG ENTIRE PARALLEL. AMBASSADOR MUCCIO CONFIRMS INVASION UNDERWAY. THIS IS NOT A BORDER RAID.",
        effects: [
            DeclareWar(a: ("PRK"), b: ("KOR")),
            SetPosture(country: ("PRK"), enemy: ("KOR"), posture: "Advance"),
            AdjustTension(200),
        ],
    ),
    EventDef(
        id: "us-intervention",
        trigger: WarDaysElapsed(a: ("PRK"), b: ("KOR"), days: 5),
        title: "KOREA: THE PRESIDENT MUST DECIDE",
        body: "WASHINGTON -- UN SECURITY COUNCIL RESOLUTION 83 RECOMMENDS MEMBERS FURNISH ASSISTANCE TO REPUBLIC OF KOREA TO REPEL ARMED ATTACK. SOVIET DELEGATE ABSENT -- NO VETO. ROK ARMY IN GENERAL RETREAT. SEOUL EXPECTED TO FALL WITHIN DAYS. GENERAL MACARTHUR REPORTS SOUTH WILL COLLAPSE WITHOUT IMMEDIATE COMMITMENT OF US GROUND FORCES FROM JAPAN. THE LINE MUST BE DRAWN SOMEWHERE -- OR NOWHERE.",
        country: Some(("USA")),
        deadline_days: 3,
        options: [
            EventOption(
                label: "COMMIT US GROUND FORCES",
                effects: [
                    DeclareWar(a: ("USA"), b: ("PRK")),
                    SetPosture(country: ("USA"), enemy: ("PRK"), posture: "Advance"),
                    SetPosture(country: ("KOR"), enemy: ("PRK"), posture: "Advance"),
                    SpawnForces(owner: ("USA"), province_owner: ("KOR"), province: "South Gyeongsang", archetype: "Infantry", divisions: 3, quality: 1250),
                    SpawnForces(owner: ("USA"), province_owner: ("KOR"), province: "Busan", archetype: "Armor", divisions: 1, quality: 1300),
                    AdjustTension(100),
                ],
            ),
            EventOption(
                label: "STAND ASIDE",
                effects: [
                    AdjustTension(-30),
                ],
            ),
        ],
    ),
    EventDef(
        id: "inchon-landing",
        trigger: WarDaysElapsed(a: ("USA"), b: ("PRK"), days: 80),
        title: "LANDING AT INCHON",
        body: "TOKYO -- FLASH -- X CORPS ASHORE AT INCHON AGAINST LIGHT OPPOSITION. TIDES RAN THIRTY FEET AND THE PLAN WORKED ANYWAY. ENEMY SUPPLY LINES TO THE SOUTH CUT. GENERAL MACARTHUR OBSERVED THE LANDING FROM MOUNT MCKINLEY. THE WAR HAS A SECOND FRONT.",
        effects: [
            SpawnForces(owner: ("USA"), province_owner: ("KOR"), province: "Gyeonggi", archetype: "Infantry", divisions: 3, quality: 1250),
            SpawnForces(owner: ("USA"), province_owner: ("KOR"), province: "Gyeonggi", archetype: "Armor", divisions: 1, quality: 1300),
            AdjustTension(20),
        ],
    ),
    EventDef(
        id: "chinese-intervention",
        trigger: ProvincesLost(owner: ("PRK"), count: 3),
        chance_permille: Some(250),
        title: "CHINA ENTERS THE WAR",
        body: "TOKYO -- FLASH -- MASSIVE CHINESE FORCES IDENTIFIED IN CONTACT ACROSS BROAD FRONT. PRISONERS CONFIRM REGULAR PLA FORMATIONS DESIGNATED CHINESE PEOPLES VOLUNTEERS. STRENGTH ESTIMATE REVISED UPWARD REPEATEDLY -- NOW EXCEEDS TWO HUNDRED THOUSAND. UN FORWARD ELEMENTS ENGAGED AND CUT OFF. PEKING RADIO: CHINA WILL NOT STAND IDLY BY WHILE THE FLAMES OF WAR SPREAD TO THE YALU. AN ENTIRELY NEW WAR.",
        effects: [
            DeclareWar(a: ("PRC"), b: ("KOR")),
            DeclareWar(a: ("PRC"), b: ("USA")),
            SetPosture(country: ("PRC"), enemy: ("KOR"), posture: "Advance"),
            SetPosture(country: ("PRC"), enemy: ("USA"), posture: "Advance"),
            SetPosture(country: ("USA"), enemy: ("PRK"), posture: "Hold"),
            SetPosture(country: ("KOR"), enemy: ("PRK"), posture: "Hold"),
            SpawnForces(owner: ("PRC"), province_owner: ("PRC"), province: "Liaoning", archetype: "Infantry", divisions: 6, quality: 1050),
            SpawnForces(owner: ("PRC"), province_owner: ("PRC"), province: "Jilin", archetype: "Infantry", divisions: 2, quality: 1000),
            AdjustTension(150),
        ],
    ),
    EventDef(
        id: "un-second-wind",
        trigger: WarDaysElapsed(a: ("PRC"), b: ("USA"), days: 25),
        title: "EIGHTH ARMY REBUILDS THE LINE",
        body: "SEOUL -- UN FORCES COMPLETE WITHDRAWAL TO DEFENSIBLE POSITIONS. REINFORCEMENTS AND REBUILT ROK DIVISIONS ENTER THE LINE. RIDGWAY: THERE WILL BE NO MORE RETREATING. GENERAL WALKER DEAD IN A JEEP ACCIDENT. THE FRONT WILL HOLD WHERE IT STANDS.",
        effects: [
            SpawnForces(owner: ("USA"), province_owner: ("KOR"), province: "South Gyeongsang", archetype: "Infantry", divisions: 4, quality: 1200),
            SpawnForces(owner: ("KOR"), province_owner: ("KOR"), province: "Busan", archetype: "Infantry", divisions: 4, quality: 950),
        ],
    ),
]
